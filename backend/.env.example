# ============================================
# Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For local development with PostgreSQL running on localhost
DATABASE_URL=postgresql+asyncpg://podcast_user:podcast_password@localhost:5432/podcast_db

# SQL Echo - Log all SQL queries (useful for debugging)
SQL_ECHO=False

# ============================================
# API KEYS (REQUIRED)
# ============================================

# OpenAI API Key - Used for script generation with GPT-4o
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key - Used for text-to-speech audio generation
# Get your key from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Firecrawl API Key - Used for web scraping news articles
# Get your key from: https://www.firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# News API Key - Used for discovering news articles
# Get your key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# ============================================
# APPLICATION SETTINGS
# ============================================

# Environment: development or production
ENVIRONMENT=development

# Debug mode
DEBUG=True

# ============================================
# JWT AUTHENTICATION SETTINGS
# ============================================

# Secret key for JWT tokens - CHANGE THIS IN PRODUCTION!
# Generate a secure key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32

# JWT Algorithm
ALGORITHM=HS256

# JWT Token expiration in minutes (default: 7 days = 10080 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ============================================
# LANGSMITH CONFIGURATION (OPTIONAL)
# ============================================
# LangSmith provides AI call tracing and observability

# Enable LangSmith tracing
LANGSMITH_TRACING=true

# LangSmith API endpoint
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# LangSmith API Key (optional - only if you want tracing)
# Get your key from: https://smith.langchain.com/
LANGSMITH_API_KEY=

# LangSmith Project Name
LANGSMITH_PROJECT=personal-podcast

# ============================================
# NEWS API CONFIGURATION
# ============================================

# News API Base URL (default is fine for most users)
NEWS_API_BASE_URL=https://newsapi.org/v2
