# ==============================================================================
# Personal Podcast Generator - Docker Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values
# This file contains all environment variables needed for Docker deployment

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=podcast_user
POSTGRES_PASSWORD=podcast_password
POSTGRES_DB=podcast_db
POSTGRES_PORT=5432

# Database URL (automatically constructed from above)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://podcast_user:podcast_password@db:5432/podcast_db

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
SQL_ECHO=False

# ------------------------------------------------------------------------------
# Service Ports
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# API Keys (REQUIRED - Replace with your actual keys)
# ------------------------------------------------------------------------------
# OpenAI API Key for GPT-4o script generation
OPENAI_API_KEY=your_openai_api_key_here

# ElevenLabs API Key for text-to-speech audio generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Firecrawl API Key for web scraping
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ------------------------------------------------------------------------------
# Optional: Advanced Configuration
# ------------------------------------------------------------------------------
# Number of uvicorn workers (default: 4 for production)
# UVICORN_WORKERS=4

# Log level (debug, info, warning, error, critical)
# LOG_LEVEL=info

# Maximum upload file size (in MB)
# MAX_UPLOAD_SIZE=10

# Audio generation timeout (in seconds)
# AUDIO_TIMEOUT=300

# ==============================================================================
# Development Mode Settings
# ==============================================================================
# Uncomment these for local development:
# ENVIRONMENT=development
# DEBUG=True
# SQL_ECHO=True
